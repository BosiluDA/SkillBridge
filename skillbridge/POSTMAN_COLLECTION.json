{
  "info": {
    "name": "SkillBridge API",
    "_postman_id": "skillbridge-collection-2026",
    "description": "Complete API collection for SkillBridge BSc Project",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000", "type": "string" },
    { "key": "token",   "value": "",                      "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/register" },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sarah Martinez\",\n  \"email\": \"sarah@test.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login" },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"sarah@test.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/auth/me" }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Browse All Users",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/users" }
          }
        },
        {
          "name": "Search Users by Skill",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/users?search=guitar" }
          }
        },
        {
          "name": "Update My Profile",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/api/users/profile" },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sarah Martinez\",\n  \"bio\": \"Software engineer passionate about teaching Python!\",\n  \"skillsOffered\": [\"Python\", \"Web Development\", \"Data Analysis\"],\n  \"skillsWanted\": [\"Guitar\", \"Spanish\", \"Photography\"]\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Exchanges",
      "item": [
        {
          "name": "Send Exchange Request",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/api/exchanges" },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"receiverId\": \"PASTE_USER_ID_HERE\",\n  \"skillWanted\": \"Guitar Lessons\",\n  \"skillOffered\": \"Python Programming\",\n  \"message\": \"Hi! I would love to exchange skills with you.\"\n}"
            }
          }
        },
        {
          "name": "Get My Exchanges",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/exchanges" }
          }
        },
        {
          "name": "Get Pending Exchanges",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/exchanges?status=pending" }
          }
        },
        {
          "name": "Accept Exchange",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/api/exchanges/EXCHANGE_ID_HERE/status" },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"accepted\"\n}"
            }
          }
        },
        {
          "name": "Mark Exchange Complete",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/api/exchanges/EXCHANGE_ID_HERE/status" },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"completed\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Reviews",
      "item": [
        {
          "name": "Submit Review",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/api/reviews" },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"exchangeId\": \"EXCHANGE_ID_HERE\",\n  \"rating\": 5,\n  \"comment\": \"Excellent teacher, very patient!\"\n}"
            }
          }
        },
        {
          "name": "Get Reviews for User",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/reviews/user/USER_ID_HERE" }
          }
        }
      ]
    },
    {
      "name": "Messages",
      "item": [
        {
          "name": "Send Message",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/api/messages" },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"exchangeId\": \"EXCHANGE_ID_HERE\",\n  \"text\": \"Hi! Are you free on Tuesday?\"\n}"
            }
          }
        },
        {
          "name": "Get Messages for Exchange",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/messages/EXCHANGE_ID_HERE" }
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Get Stats",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/admin/stats" }
          }
        },
        {
          "name": "Get All Exchanges",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/admin/exchanges" }
          }
        },
        {
          "name": "Export Data",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/admin/export" }
          }
        }
      ]
    }
  ]
}
